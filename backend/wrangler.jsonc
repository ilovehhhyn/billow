{
  "name": "billow-planner",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {
    "ALLOWED_ORIGINS": "https://ilovehhhyn.github.io",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "ratelimits": [{
    "name": "PLANNER_LIMIT",
    "namespace_id": "1001",
    "simple": {"limit": 5, "period": 60}
  }]
}
